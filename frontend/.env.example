# Frontend environment variables.
# For local development, create frontend/.env and set VITE_API_URL if your backend
# is not at http://127.0.0.1:5000.
#
# For production builds on Render, set VITE_API_URL in the Render dashboard
# (Static Site → Environment → Add environment variable).
# It is injected at BUILD TIME — the built JS bundle contains the URL directly.

# Backend URL (default: http://127.0.0.1:5000)
# VITE_API_URL=https://expertos-backend.onrender.com
