# Copy this file to backend/.env and fill in your own values.
# backend/.env is git-ignored. Keys are only read by the Flask backend and are
# never sent to the browser.

# Primary AI provider (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Optional comma-separated OpenRouter model IDs, tried in order.
# Leave empty to use the defaults in services/openrouter_client.py.
# Check availability with: python scripts/check_ai_providers.py
OPENROUTER_MODELS=

# Model reasoning for models that support it: off | low | medium | high.
# "off" is recommended: reasoning tokens count against each request's budget.
OPENROUTER_REASONING=off

# Optional comma-separated image-capable OpenRouter models, tried in order
# when screenshots are attached. Leave empty for the defaults.
OPENROUTER_VISION_MODELS=

# Optional fallback providers (leave empty to disable)
GEMINI_API_KEY=
GROQ_API_KEY=
# Groq model for fallback (check available IDs at GET https://api.groq.com/openai/v1/models)
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_URL=http://localhost:11434

# Verify HTTPS certificates against the operating system's trust store
# (needed behind antivirus HTTPS scanning or corporate proxies). Set to false
# to use Python's bundled certificate list instead.
USE_SYSTEM_CERTIFICATES=true
